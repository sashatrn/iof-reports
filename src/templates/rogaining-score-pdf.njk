{% extends "base-pdf.njk" %}

{% block content %}
{% import "official-signature.njk" as officialSignature %}

<h1 class="score-doc-title">Звіт</h1>
<div class="score-doc-subtitle">про проведення змагань</div>

<div class="score-doc-meta">
  <div class="score-doc-meta-row">
    <div class="score-doc-meta-number">1.</div>
    <div><strong>Вид спорту:</strong> {{ scoreReport.sport }}</div>
  </div>
  <div class="score-doc-meta-row">
    <div class="score-doc-meta-number">2.</div>
    <div>
      <strong>Повна назва змагань:</strong> {{ scoreReport.competitionName }}
      {% if scoreReport.orderText %}
      <div class="score-doc-meta-extra">{{ scoreReport.orderText }}</div>
      {% endif %}
    </div>
  </div>
  <div class="score-doc-meta-row">
    <div class="score-doc-meta-number">3.</div>
    <div><strong>Дата проведення:</strong> {{ scoreReport.dateText }}</div>
  </div>
  <div class="score-doc-meta-row">
    <div class="score-doc-meta-number">4.</div>
    <div><strong>Повна назва місця проведення:</strong> {{ scoreReport.placeName }}</div>
  </div>
  <div class="score-doc-meta-row">
    <div class="score-doc-meta-number">5.</div>
    <div><strong>Загальна кількість учасників змагань:</strong> {{ scoreReport.participantCount }}</div>
  </div>
  <div class="score-doc-meta-row">
    <div class="score-doc-meta-number">6.</div>
    <div><strong>Кількість країн/регіонів:</strong> {{ scoreReport.regionCount }}</div>
  </div>
  <div class="score-doc-meta-row">
    <div class="score-doc-meta-number">7.</div>
    <div>
      <strong>Кількість (команд):</strong> {{ scoreReport.teamCount }}
      <div class="score-doc-meta-extra"><strong>Зайняте командне місце:</strong> {{ scoreReport.teamPlaceText }}</div>
    </div>
  </div>
  <div class="score-doc-meta-row">
    <div class="score-doc-meta-number">8.</div>
    <div><strong>Інформація про захід:</strong> {{ scoreReport.eventInfo }}</div>
  </div>
  <div class="score-doc-meta-row">
    <div class="score-doc-meta-number">9.</div>
    <div><strong>Результати змагань:</strong></div>
  </div>
</div>

<div class="score-doc-results-title">{{ scoreReport.resultsTitle }}</div>

<table class="score-doc-results">
  <thead>
    <tr>
      <th>Прізвище, ім'я, по батькові спортсмена</th>
      <th>Регіон</th>
      <th>ФСТ, відомство</th>
      <th>Вид програми, дистанції, вагові категорії, рекорди</th>
      <th>місце</th>
      <th class="score-doc-points-cell">очки рейтин-гу</th>
    </tr>
  </thead>
  <tbody>
    {% for entry in entries %}
    <tr>
      <td>{{ entry.participantName }}</td>
      <td>{{ entry.region }}</td>
      <td>{{ scoreReport.departmentName }}</td>
      <td>{{ entry.className }}{% if scoreReport.programName %} ({{ scoreReport.programName }}){% endif %}</td>
      <td class="score-doc-place-cell">{{ entry.place }}</td>
      <td class="score-doc-points-cell">{{ entry.points }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>

<div class="score-doc-section-title">Групи регіонів</div>

{% if regionTables.layout == "flat" %}
<table class="score-doc-region-groups score-doc-flat-regions">
  <thead>
    <tr>
      <th>№ з/п</th>
      <th>Регіони</th>
      <th class="score-doc-points-cell">Очки</th>
      <th>№ з/п</th>
      <th>Регіони</th>
      <th class="score-doc-points-cell">Очки</th>
      <th>№ з/п</th>
      <th>ФСТ/відомства</th>
      <th class="score-doc-points-cell">Очки</th>
    </tr>
  </thead>
  <tbody>
    {% for row in regionTables.flatRows %}
    <tr>
      <td class="score-doc-number-cell">{% if row.left %}{{ row.left.number }}{% endif %}</td>
      <td>{% if row.left %}{{ row.left.name }}{% endif %}</td>
      <td class="score-doc-points-cell">{% if row.left and row.left.points > 0 %}{{ row.left.points }}{% endif %}</td>
      <td class="score-doc-number-cell">{% if row.middle %}{{ row.middle.number }}{% endif %}</td>
      <td>{% if row.middle %}{{ row.middle.name }}{% endif %}</td>
      <td class="score-doc-points-cell">{% if row.middle and row.middle.points > 0 %}{{ row.middle.points }}{% endif %}</td>
      <td class="score-doc-number-cell">{% if row.organization %}{{ row.organization.number }}{% endif %}</td>
      <td>{% if row.organization %}{{ row.organization.name }}{% endif %}</td>
      <td class="score-doc-points-cell">{% if row.organization and row.organization.points > 0 %}{{ row.organization.points }}{% endif %}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% else %}
<table class="score-doc-region-groups">
  <thead>
    <tr>
      <th>№ з/п</th>
      <th>I група</th>
      <th class="score-doc-points-cell">Кількість очок</th>
      <th>місце</th>
      <th>II група</th>
      <th class="score-doc-points-cell">Кількість очок</th>
      <th>місце</th>
    </tr>
  </thead>
  <tbody>
    {% for row in regionTables.groups.group1And2 %}
    <tr>
      <td class="score-doc-number-cell">{{ row.number }}</td>
      <td>{% if row.left %}{{ row.left.name }}{% endif %}</td>
      <td class="score-doc-points-cell">{% if row.left and row.left.points > 0 %}{{ row.left.points }}{% endif %}</td>
      <td class="score-doc-place-cell">{% if row.left %}{{ row.left.place }}{% endif %}</td>
      <td>{% if row.right %}{{ row.right.name }}{% endif %}</td>
      <td class="score-doc-points-cell">{% if row.right and row.right.points > 0 %}{{ row.right.points }}{% endif %}</td>
      <td class="score-doc-place-cell">{% if row.right %}{{ row.right.place }}{% endif %}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>

<table class="score-doc-region-groups">
  <thead>
    <tr>
      <th>№ з/п</th>
      <th>III група</th>
      <th class="score-doc-points-cell">Кількість очок</th>
      <th>місце</th>
      <th>ФСТ та відомства</th>
      <th class="score-doc-points-cell">Кількість очок</th>
      <th>місце</th>
    </tr>
  </thead>
  <tbody>
    {% for row in regionTables.groups.group3AndOrganizations %}
    <tr>
      <td class="score-doc-number-cell">{{ row.number }}</td>
      <td>{% if row.left %}{{ row.left.name }}{% endif %}</td>
      <td class="score-doc-points-cell">{% if row.left and row.left.points > 0 %}{{ row.left.points }}{% endif %}</td>
      <td class="score-doc-place-cell">{% if row.left %}{{ row.left.place }}{% endif %}</td>
      <td>{% if row.right %}{{ row.right.name }}{% endif %}</td>
      <td class="score-doc-points-cell">{% if row.right and row.right.points > 0 %}{{ row.right.points }}{% endif %}</td>
      <td class="score-doc-place-cell">{% if row.right %}{{ row.right.place }}{% endif %}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% endif %}

<div class="score-doc-signatures">
  <div class="score-doc-signature-row">
    <div>{{ scoreReport.signatures.chiefJudgeTitle }}</div>
    {{ officialSignature.render(officials.chiefJudge, "", true) }}
  </div>
  <div class="score-doc-signature-row">
    <div>{{ scoreReport.signatures.departmentHeadTitle }}</div>
    {{ officialSignature.render(officials.departmentHead, "", true) }}
  </div>
  <div class="score-doc-signature-row">
    <div>{{ scoreReport.signatures.sportResponsibleTitle }}</div>
    {{ officialSignature.render(officials.sportResponsible, "", true) }}
  </div>
  <div class="score-doc-footer-date">{{ scoreReport.signatures.footerDateText }}</div>
</div>

{% endblock %}
