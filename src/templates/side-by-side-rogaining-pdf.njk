{% extends "base-pdf.njk" %}

{% block content %}

<h2>Індивідуальні результати</h2>
{% for class in classes %}
<div class="class-block">
  <h3>{{ class.name }}</h3>

  <table>
    <thead>
      <tr>
        <th class="place-cell">Місце</th>
        <th>Учасник</th>
        <th>Команда</th>
        <th>Кількість КП</th>
        <th>Час</th>
        <th>Відст.</th>
        <th class="points-cell">Бал</th>
        <th>Статус</th>
      </tr>
    </thead>
    <tbody>
      {% for participant in class.participants %}
      <tr>
        <td class="place-cell"><strong>{{ participant.position }}</strong></td>
        <td>{{ participant.name }}</td>
        <td>{{ participant.organisation }}</td>
        <td>{{ participant.controlCount }}</td>
        <td>{{ participant.time }}</td>
        <td>{{ participant.timeBehind }}</td>
        <td class="points-cell">{% if participant.points > 0 %}{{ participant.points }}{% endif %}</td>
        <td>{{ participant.status | statusLabel }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endfor %}

{% if teamResults and teamResults.length %}
<div class="class-block">
  <h2>Командні результати</h2>

  <table>
    <thead>
      <tr>
        <th class="place-cell">Місце</th>
        <th>Команда</th>
        <th class="points-cell">Бал</th>
      </tr>
    </thead>
    <tbody>
      {% for team in teamResults %}
      <tr>
        <td class="place-cell"><strong>{{ team.place }}</strong></td>
        <td>{{ team.organisation }}</td>
        <td class="points-cell"><strong>{% if team.points > 0 %}{{ team.points }}{% endif %}</strong></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}

{% endblock %}
