{% extends "base-view.njk" %}

{% block content %}

{% for class in classes %}
<div class="class-block">
  <h3>{{ class.name }}</h3>

  <table>
    <thead>
      <tr>
        <th>Місце</th>
        <th>Учасник</th>
        <th>Команда</th>
        <th>Час</th>
        <th>Відст.</th>
        <th>Бал</th>
        <th>Статус</th>
      </tr>
    </thead>
    <tbody>
      {% for p in class.participants %}
      <tr data-status="{{ p.status }}">
        <td>{{ p.position }}</td>
        <td>{{ p.name }}</td>
        <td>{{ p.club }}</td>
        <td>{{ p.time }}</td>
        <td>{{ p.timeBehind }}</td>
        <td>{% if p.points > 0 %}{{ p.points }}{% endif %}</td>
        <td>{{ p.status | statusLabel }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endfor %}

{% endblock %}
