{% extends "base-view.njk" %}

{% block content %}

{% for class in classes %}
<div class="class-block">
  <h3>{{ class.name }}</h3>

  <table>
    <thead>
      <tr>
        <th>Місце</th>
        <th>Учасник</th>
        <th>Бал</th>
        <th>Штраф</th>
        <th>Разом</th>
        <th>Час</th>
        <th>Статус</th>
      </tr>
    </thead>
    <tbody>
      {% for participant in class.participants %}
      <tr data-status="{{ participant.status }}">
        <td><strong>{{ participant.position }}</strong></td>
        <td>{{ participant.name }}</td>
        <td>{{ participant.score }}</td>
        <td><strong>{{ participant.penalty }}</strong></td>
        <td><strong>{{ participant.totalScore }}</strong></td>
        <td>{{ participant.time }}</td>
        <td>{{ participant.status | statusLabel }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endfor %}

{% endblock %}
