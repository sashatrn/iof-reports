{% extends "base-pdf.njk" %}

{% block content %}

{% for class in classes %}
<div class="class-block">
  <h3>{{ class.name }}</h3>

  <table>
    <thead>
      <tr>
        <th class="place-cell">Місце</th>
        <th>Команда</th>
        <th>Учасники</th>
        <th>ВВНЗ, військо</th>
        {% for stageNumber in stageNumbers %}
        <th>Етап&nbsp;{{ stageNumber }}</th>
        {% endfor %}
        <th>Час</th>
        <th>Відст.</th>
        <th class="points-cell">Очки</th>
        <th>Статус</th>
      </tr>
    </thead>
    <tbody>
      {% for team in class.teams %}
      <tr>
        <td class="place-cell"><strong>{{ team.place }}</strong></td>
        <td><strong>{{ team.teamName }}</strong></td>
        <td>{{ team.membersLine }}</td>
        <td>{{ team.organisation }}</td>
        {% for stageTime in team.stageTimes %}
        <td>{{ stageTime }}</td>
        {% endfor %}
        <td>{{ team.formattedTime }}</td>
        <td>{{ team.timeBehind }}</td>
        <td class="points-cell"><strong>{{ team.points }}</strong></td>
        <td>{{ team.status | statusLabel }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endfor %}

{% if teamResults and teamResults.length %}
<div class="class-block">
  <h3>Загальнокомандний результат</h3>

  {% for group in teamResults %}
  <h4>{{ group.name }}</h4>

  <table>
    <thead>
      <tr>
        <th class="place-cell">Місце</th>
        <th>Команда</th>
        <th class="points-cell">Очки</th>
      </tr>
    </thead>
    <tbody>
      {% for team in group.teams %}
      <tr>
        <td class="place-cell"><strong>{{ team.place }}</strong></td>
        <td>{{ team.organisation }}</td>
        <td class="points-cell"><strong>{{ team.points }}</strong></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endfor %}
</div>
{% endif %}

{% endblock %}
