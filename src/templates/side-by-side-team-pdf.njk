{% extends "base-pdf.njk" %}

{% block content %}

{% for group in teamResultGroups %}
<h3>{{ group.name }}</h3>
<table>
  <thead>
    <tr>
      <th class="place-cell">Місце</th>
      <th>Команда</th>
      <th class="points-cell">Бал</th>
    </tr>
  </thead>
  <tbody>
    {% for t in group.teams %}
    <tr>
      <td class="place-cell">{{ t.place }}</td>
      <td>{{ t.organisation }}</td>
      <td class="points-cell">{% if t.points > 0 %}{{ t.points }}{% endif %}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% endfor %}

{% endblock %}
