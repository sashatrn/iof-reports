{% extends "base-view.njk" %}

{% block content %}

{% for class in classes %}
<div class="class-block">
  <h3>{{ class.name }}</h3>

  <table>
    <thead>
      <tr>
        <th>Місце</th>
        <th>Команда</th>
        <th>Учасники</th>
        <th>{{ relay.organisationLabel }}</th>
        {% for stageNumber in stageNumbers %}
        <th>Етап&nbsp;{{ stageNumber }}</th>
        {% endfor %}
        <th>Час</th>
        <th>Відст.</th>
        <th>Бал</th>
        <th>Статус</th>
      </tr>
    </thead>
    <tbody>
      {% for team in class.teams %}
      <tr data-status="{{ team.rowStatus }}">
        <td><strong>{{ team.place }}</strong></td>
        <td><strong>{{ team.teamName }}</strong></td>
        <td>{{ team.membersLine }}</td>
        <td>{{ team.organisation }}</td>
        {% for stageTime in team.stageTimes %}
        <td>{{ stageTime }}</td>
        {% endfor %}
        <td>{{ team.formattedTime }}</td>
        <td>{{ team.timeBehind }}</td>
        <td><strong>{% if relay.showZeroPoints or team.points > 0 %}{{ team.points }}{% endif %}</strong></td>
        <td>{{ team.status | statusLabel }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endfor %}

{% endblock %}
