{% extends "base-pdf.njk" %}

{% block content %}

{% for class in classes %}
<div class="class-block">
  <h3>{{ class.name }}</h3>

  <table>
    <thead>
      <tr>
        <th>Місце</th>
        <th>Учасник</th>
        <th>Команда</th>
        <th>Час</th>
        <th>Відст.</th>
        <th>Бал</th>
        <th>Статус</th>
      </tr>
    </thead>
    <tbody>
      {% for p in class.participants %}
      <tr>
        <td>{{ p.position }}</td>
        <td>{{ p.name }}</td>
        <td>{{ p.club }}</td>
        <td>{{ p.time }}</td>
        <td>{{ p.timeBehind }}</td>
        <td>{{ p.points }}</td>
        <td>{{ p.status | statusLabel }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endfor %}

{% if teamResults and (teamResults.men.length or teamResults.women.length) %}
<div class="class-block">
  <h3>Командні результати</h3>

  {% if teamResults.men.length %}
  <h4>Чоловіки</h4>

  <table>
    <thead>
      <tr>
        <th>Місце</th>
        <th>Команда</th>
        <th>Бал</th>
      </tr>
    </thead>
    <tbody>
      {% for team in teamResults.men %}
      <tr>
        <td><strong>{{ loop.index }}</strong></td>
        <td>{{ team.club }}</td>
        <td><strong>{{ team.points }}</strong></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}

  {% if teamResults.women.length %}
  <h4>Жінки</h4>

  <table>
    <thead>
      <tr>
        <th>Місце</th>
        <th>Команда</th>
        <th>Бал</th>
      </tr>
    </thead>
    <tbody>
      {% for team in teamResults.women %}
      <tr>
        <td><strong>{{ loop.index }}</strong></td>
        <td>{{ team.club }}</td>
        <td><strong>{{ team.points }}</strong></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}
</div>
{% endif %}

{% endblock %}
