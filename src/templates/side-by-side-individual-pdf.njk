{% extends "base-pdf.njk" %}

{% block content %}

<h2>Індивідуальні результати</h2>
{% for class in classes %}
<div class="class-block">
  <h3>{{ class.name }}</h3>

  <table>
    <thead>
      <tr>
        <th class="place-cell">Місце</th>
        <th>Учасник</th>
        <th>Команда</th>
        <th>Час</th>
        <th>Відст.</th>
        <th class="points-cell">Бал</th>
        <th>Статус</th>
      </tr>
    </thead>
    <tbody>
      {% for p in class.participants %}
      <tr>
        <td class="place-cell">{{ p.position }}</td>
        <td>{{ p.name }}</td>
        <td>{{ p.club }}</td>
        <td>{{ p.time }}</td>
        <td>{{ p.timeBehind }}</td>
        <td class="points-cell">{% if p.points > 0 %}{{ p.points }}{% endif %}</td>
        <td>{{ p.status | statusLabel }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endfor %}

{% if teamResults and (teamResults.men.length or teamResults.women.length) %}
<div class="class-block">
  <h2>Командні результати</h2>

  {% if teamResults.men.length %}
  {% if teamResults.women.length %}<h4>Чоловіки</h4>{% endif %}

  <table>
    <thead>
      <tr>
        <th class="place-cell">Місце</th>
        <th>Команда</th>
        <th class="points-cell">Бал</th>
      </tr>
    </thead>
    <tbody>
      {% for team in teamResults.men %}
      <tr>
        <td class="place-cell"><strong>{{ loop.index }}</strong></td>
        <td>{{ team.club }}</td>
        <td class="points-cell"><strong>{% if team.points > 0 %}{{ team.points }}{% endif %}</strong></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}

  {% if teamResults.women.length %}
  {% if teamResults.men.length %}<h4>Жінки</h4>{% endif %}

  <table>
    <thead>
      <tr>
        <th class="place-cell">Місце</th>
        <th>Команда</th>
        <th class="points-cell">Бал</th>
      </tr>
    </thead>
    <tbody>
      {% for team in teamResults.women %}
      <tr>
        <td class="place-cell"><strong>{{ loop.index }}</strong></td>
        <td>{{ team.club }}</td>
        <td class="points-cell"><strong>{% if team.points > 0 %}{{ team.points }}{% endif %}</strong></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}
</div>
{% endif %}

{% endblock %}
