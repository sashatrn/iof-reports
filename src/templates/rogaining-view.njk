{% extends "base-view.njk" %}

{% block content %}

{% for class in classes %}
<div class="class-block" data-class-group="{{ class.name }}">
  <h3>{{ class.name }}</h3>

  <table>
    <thead>
      <tr>
        <th>Місце</th>
        <th>Команда</th>
        <th>Заявл. клас</th>
        <th>Учасники</th>
        <th>Регіон</th>
        <th>Бали</th>
        <th>Штраф</th>
        <th>Разом</th>
        <th>Час</th>
        {% if showControlGateColumn %}
        <th>{{ controlGateLabel }}</th>
        {% endif %}
        <th>Статус</th>
      </tr>
    </thead>
    <tbody>
      {% for team in class.teams %}
      <tr data-status="{{ team.status }}">
        <td><strong>{{ team.place }}</strong></td>
        <td><strong>{{ team.teamName }}</strong></td>
        <td>{{ team.sourceClassName }}</td>
        <td>{{ team.membersLine }}</td>
        <td>{{ team.organisation }}</td>
        <td>{{ team.score }}</td>
        <td><strong>{{ team.penalty }}</strong></td>
        <td><strong>{{ team.totalScore }}</strong></td>
        <td>{{ team.formattedTime }}</td>
        {% if showControlGateColumn %}
        <td>{{ team.controlGateStatus }}</td>
        {% endif %}
        <td>{{ team.status }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endfor %}

{% endblock %}
