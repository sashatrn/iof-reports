{% extends "base.njk" %}

{% block content %}

{% for group in teamResultGroups %}
<h3>{{ group.name }}</h3>
<table>
  <thead>
    <tr>
      <th>Місце</th>
      <th>Команда</th>
      <th>Бал</th>
    </tr>
  </thead>
  <tbody>
    {% for t in group.teams %}
    <tr>
      <td>{{ t.place }}</td>
      <td>{{ t.organisation }}</td>
      <td>{% if t.points > 0 %}{{ t.points }}{% endif %}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% endfor %}

{% endblock %}
