<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <style>
    @page {
      size: A4;
      margin: 20mm 15mm 20mm 15mm;

      @bottom-center {
        content: "Сторінка " counter(page) " з " counter(pages);
        font-size: 9pt;
      }
    }

    body {
      font-family: Arial, sans-serif;
      font-size: 10pt;
      line-height: 1.25;
      margin: 0;
      padding: 0;
      color: #111;
      background: white;
    }

    .top-content {
      margin: 0 0 5mm 0;
    }

    .header-brand {
      display: grid;
      grid-template-columns: 24mm 1fr 24mm;
      gap: 6mm;
      align-items: start;
    }

    .logo-slot {
      min-height: 20mm;
      display: flex;
      align-items: flex-start;
    }

    .logo-slot.right {
      justify-content: flex-end;
    }

    .logo-slot img {
      height: 20mm;
      width: auto;
      max-width: 35mm;
      object-fit: contain;
    }

    .event-head {
      text-align: center;
    }

    .event-title {
      margin: 0 0 2mm 0;
    }

    .report-title {
      font-size: 14pt;
      margin: 3mm 0 3mm 0;
    }

    .event-subtitle {
      margin: 0 0 4mm 0;
    }

    .header-row {
      display: flex;
      justify-content: space-between;
      margin: 3mm 0 0 0;
      font-size: 10pt;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin: 0 0 4mm 0;
      break-before: avoid;
      page-break-before: avoid;
    }

    thead {
      display: table-header-group;
    }

    th, td {
      border: 0.3mm solid #000;
      padding: 0.5mm;
      font-size: 8pt;
      vertical-align: top;
    }

    th {
      background: #eee;
    }

    h3,
    h4,
    .score-doc-section-title,
    .score-doc-results-title,
    .results-class-meta,
    .results-course-meta {
      break-after: avoid;
      break-inside: avoid;
      page-break-after: avoid;
      page-break-inside: avoid;
    }

    table:has(+ .footer),
    table:has(+ [class$="-signatures"]),
    table:has(+ [class*="-signatures "]),
    .class-block:has(+ .footer),
    .class-block:has(+ [class$="-signatures"]),
    .class-block:has(+ [class*="-signatures "]),
    .results-class:has(+ [class$="-signatures"]),
    .results-class:has(+ [class*="-signatures "]),
    .results-class:has(+ [class$="-signatures"]) table,
    .results-class:has(+ [class*="-signatures "]) table {
      break-after: avoid;
      page-break-after: avoid;
    }

    tr {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    [class$="-signatures"],
    [class*="-signatures "] {
      break-before: avoid;
      break-inside: avoid;
      page-break-before: avoid;
      page-break-inside: avoid;
    }

    [class$="-signature-row"],
    [class*="-signature-row "] {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .footer {
      margin: 10mm auto 0 auto;
      width: 130mm;
      break-before: avoid;
      break-inside: avoid;
      page-break-before: avoid;
      page-break-inside: avoid;
    }

    .official-row {
      display: grid;
      grid-template-columns: 90mm 1fr;
      align-items: center;
      margin-bottom: 4mm;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    h3 {
      margin: 3mm 0 1mm 0;
    }

    h4 {
      font-size: 10pt;
      margin: 2mm 0 1mm 0;
    }

    .score-doc-title {
      text-align: center;
      font-size: 14pt;
      margin: 0;
    }

    .score-doc-subtitle {
      text-align: center;
      font-size: 12pt;
      margin: 0 0 5mm 0;
    }

    .score-doc-meta {
      margin-bottom: 4mm;
    }

    .score-doc-meta-row {
      display: grid;
      grid-template-columns: 7mm 1fr;
      column-gap: 1mm;
      margin-bottom: 1mm;
    }

    .score-doc-meta-number {
      text-align: right;
    }

    .score-doc-meta-extra {
      margin-top: 1mm;
    }

    .score-doc-section-title {
      margin: 3mm 0 2mm 0;
      font-size: 10pt;
      font-weight: 700;
    }

    .score-doc-results-title {
      margin: 3mm 0 2mm 0;
      text-align: center;
      font-weight: 700;
    }

    .score-doc-results th,
    .score-doc-results td,
    .score-doc-region-groups th,
    .score-doc-region-groups td {
      font-size: 7.2pt;
      padding: 0.45mm;
    }

    .score-doc-region-groups {
      margin-bottom: 3mm;
    }

    .score-doc-region-groups .score-doc-number-cell {
      width: 8mm;
      text-align: center;
    }

    .score-doc-points-cell,
    .score-doc-place-cell {
      text-align: center;
      white-space: nowrap;
    }

    .score-doc-signatures {
      margin-top: 8mm;
    }

    .score-doc-signature-row {
      display: grid;
      grid-template-columns: 75mm 1fr;
      align-items: center;
      margin-bottom: 5mm;
    }

    .score-doc-footer-date {
      margin-top: 3mm;
    }

    .split-team {
      margin-bottom: 6mm;
    }

    .split-team:not(:first-child) {
      break-before: page;
      page-break-before: always;
    }

    .split-summary td {
      font-size: 8pt;
    }
  </style>
</head>
<body>

{% if showDefaultHeader !== false %}
<div class="top-content">
  <div class="header-brand">
    <div class="logo-slot">
      {% if event.logo1 %}
      <img src="{{ event.logo1 }}" alt="Logo1" />
      {% endif %}
    </div>
    <div class="event-head">
      <div class="event-title">
        {{ event.title | safe }}
      </div>

      <div class="report-title">
        {{ reportTitle }}
      </div>

      {% if event.subtitle %}
      <div class="event-subtitle">
        {{ event.subtitle | safe }}
      </div>
      {% endif %}
    </div>
    <div class="logo-slot right">
      {% if event.logo2 %}
      <img src="{{ event.logo2 }}" alt="Logo2" />
      {% endif %}
    </div>
  </div>

  <div class="header-row">
    <div>{{ event.location }}</div>
    <div>{{ event.date }}</div>
  </div>
</div>
{% endif %}

{% block content %}{% endblock %}

{% if showDefaultFooter !== false %}
<div class="footer">
  <div class="official-row">
    <div>Головний суддя</div>
    <div>{{ officials.chiefJudge }}</div>
  </div>

  <div class="official-row">
    <div>Головний секретар</div>
    <div>{{ officials.chiefSecretary }}</div>
  </div>
</div>
{% endif %}

</body>
</html>
