<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <style>
    @page {
      size: A4;
      margin: 20mm 15mm 20mm 15mm;

      @bottom-center {
        content: "Сторінка " counter(page) " з " counter(pages);
        font-size: 9pt;
      }
    }

    body {
      font-family: Arial, sans-serif;
      font-size: 10pt;
      line-height: 1.25;
      margin: 0;
      padding: 0;
      color: #111;
      background: white;
    }

    .top-content {
      margin: 0 0 5mm 0;
    }

    .header-brand {
      display: grid;
      grid-template-columns: 24mm 1fr 24mm;
      gap: 6mm;
      align-items: start;
    }

    .logo-slot {
      min-height: 20mm;
      display: flex;
      align-items: flex-start;
    }

    .logo-slot.right {
      justify-content: flex-end;
    }

    .logo-slot img {
      height: 20mm;
      width: auto;
      max-width: 24mm;
      object-fit: contain;
    }

    .event-head {
      text-align: center;
    }

    .event-title {
      margin: 0 0 2mm 0;
    }

    .report-title {
      font-size: 14pt;
      margin: 3mm 0 3mm 0;
    }

    .event-subtitle {
      margin: 0 0 4mm 0;
    }

    .header-row {
      display: flex;
      justify-content: space-between;
      margin: 3mm 0 0 0;
      font-size: 10pt;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin: 0 0 4mm 0;
    }

    thead {
      display: table-header-group;
    }

    th, td {
      border: 0.3mm solid #000;
      padding: 0.5mm;
      font-size: 8pt;
      vertical-align: top;
    }

    th {
      background: #eee;
    }

    .footer {
      margin: 10mm auto 0 auto;
      width: 130mm;
    }

    .official-row {
      display: grid;
      grid-template-columns: 90mm 1fr;
      align-items: center;
      margin-bottom: 4mm;
    }

    h3 {
      margin: 3mm 0 1mm 0;
    }
  </style>
</head>
<body>

<div class="top-content">
  <div class="header-brand">
    <div class="logo-slot">
      {% if event.logo1 %}
      <img src="{{ event.logo1 }}" alt="Logo1" />
      {% endif %}
    </div>
    <div class="event-head">
      <div class="event-title">
        {{ event.title | safe }}
      </div>

      <div class="report-title">
        {{ reportTitle }}
      </div>

      {% if event.subtitle %}
      <div class="event-subtitle">
        {{ event.subtitle | safe }}
      </div>
      {% endif %}
    </div>
    <div class="logo-slot right">
      {% if event.logo2 %}
      <img src="{{ event.logo2 }}" alt="Logo2" />
      {% endif %}
    </div>
  </div>

  <div class="header-row">
    <div>{{ event.location }}</div>
    <div>{{ event.date }}</div>
  </div>
</div>

{% block content %}{% endblock %}

<div class="footer">
  <div class="official-row">
    <div>Головний суддя</div>
    <div>{{ officials.chiefJudge }}</div>
  </div>

  <div class="official-row">
    <div>Головний секретар</div>
    <div>{{ officials.chiefSecretary }}</div>
  </div>
</div>

</body>
</html>
