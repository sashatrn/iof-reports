<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ title }}</title>
  <style>
    :root {
      --bg: #0f1720;
      --panel: rgba(15, 23, 32, 0.82);
      --text: #e8eef2;
      --muted: #9db0bd;
      --accent: #f4b942;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: "Segoe UI", sans-serif;
      background:
        radial-gradient(circle at top, rgba(244,185,66,0.18), transparent 28%),
        linear-gradient(180deg, #15212c 0%, #0f1720 100%);
      color: var(--text);
    }

    .layout {
      min-height: 100vh;
      display: grid;
      grid-template-rows: auto 1fr;
    }

    .toolbar {
      display: flex;
      gap: 12px;
      align-items: center;
      padding: 14px 18px;
      background: var(--panel);
      backdrop-filter: blur(16px);
      position: sticky;
      top: 0;
      z-index: 2;
      flex-wrap: wrap;
    }

    .toolbar h1 {
      font-size: 16px;
      margin: 0 18px 0 0;
      letter-spacing: 0.02em;
    }

    .toolbar .meta {
      color: var(--muted);
      font-size: 13px;
      margin-right: auto;
    }

    .toolbar button,
    .toolbar input {
      font: inherit;
    }

    .toolbar button {
      border: 0;
      background: var(--accent);
      color: #1c1607;
      padding: 8px 14px;
      border-radius: 999px;
      cursor: pointer;
      font-weight: 600;
    }

    .toolbar label {
      display: flex;
      gap: 8px;
      align-items: center;
      color: var(--muted);
      font-size: 13px;
    }

    .frame-stack {
      position: relative;
      height: calc(100vh - 70px);
      background: white;
      overflow: hidden;
    }

    iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
      background: white;
      opacity: 0;
      pointer-events: none;
      transition: opacity 120ms linear;
    }

    iframe.active {
      opacity: 1;
      pointer-events: auto;
    }
  </style>
</head>
<body>
  <div class="layout">
    <div class="toolbar">
      <h1>{{ title }}</h1>
      <div class="meta">source: {{ sourceFileName }} | report: {{ reportType }} | updated: <span id="updatedAt">{{ updatedAt }}</span></div>
      <button id="toggle">Pause</button>
      <button id="direction">Down</button>
      <label>Speed <input id="speed" type="range" min="10" max="200" step="5" value="45" /></label>
      <label>Pause edge <input id="pause" type="range" min="0" max="5000" step="250" value="1500" /></label>
    </div>
    <div class="frame-stack">
      <iframe id="reportFrameA" class="active" src="./report" title="{{ title }}"></iframe>
      <iframe id="reportFrameB" src="about:blank" title="{{ title }}"></iframe>
    </div>
  </div>
  <script>
    const frameA = document.getElementById("reportFrameA");
    const frameB = document.getElementById("reportFrameB");
    const toggleButton = document.getElementById("toggle");
    const directionButton = document.getElementById("direction");
    const speedInput = document.getElementById("speed");
    const pauseInput = document.getElementById("pause");
    const updatedAtNode = document.getElementById("updatedAt");

    let running = true;
    let direction = 1;
    let lastTick = 0;
    let pauseUntil = 0;
    let lastMetaFetch = 0;
    let currentUpdatedAt = "{{ updatedAt }}";
    let pendingScrollTop = 0;
    let pendingScrollRatio = 0;
    let pendingDistanceFromBottom = 0;
    let pendingDirection = 1;
    let hasPendingScrollRestore = false;
    let activeFrame = frameA;
    let standbyFrame = frameB;
    let isReloading = false;

    function getScrollable(targetFrame = activeFrame) {
      const doc = targetFrame.contentDocument;
      if (!doc) return null;
      return doc.scrollingElement || doc.documentElement;
    }

    function reloadFrame() {
      if (isReloading) {
        return;
      }

      const scrollable = getScrollable();

      if (scrollable) {
        const maxScroll = Math.max(0, scrollable.scrollHeight - scrollable.clientHeight);
        pendingScrollTop = scrollable.scrollTop;
        pendingScrollRatio = maxScroll > 0 ? scrollable.scrollTop / maxScroll : 0;
        pendingDistanceFromBottom = Math.max(0, maxScroll - scrollable.scrollTop);
        pendingDirection = direction;
        hasPendingScrollRestore = true;
      }

      isReloading = true;
      standbyFrame.src = "./report?t=" + Date.now();
    }

    function applyRestoredScroll(targetFrame) {
      const scrollable = getScrollable(targetFrame);

      if (!scrollable) {
        return;
      }

      if (hasPendingScrollRestore) {
        const maxScroll = Math.max(0, scrollable.scrollHeight - scrollable.clientHeight);
        const restoredScrollTop = maxScroll <= 0
          ? 0
          : pendingDirection === -1
            ? Math.min(maxScroll, Math.max(0, maxScroll - pendingDistanceFromBottom))
            : Math.min(maxScroll, Math.max(0, pendingScrollRatio * maxScroll));

        scrollable.scrollTop = restoredScrollTop || pendingScrollTop;
        direction = pendingDirection;
        pauseUntil = 0;
        directionButton.textContent = direction === 1 ? "Down" : "Up";
        hasPendingScrollRestore = false;
        return;
      }

      scrollable.scrollTop = 0;
    }

    function swapFrames() {
      activeFrame.classList.remove("active");
      standbyFrame.classList.add("active");

      const previousActive = activeFrame;
      activeFrame = standbyFrame;
      standbyFrame = previousActive;
      isReloading = false;
    }

    async function refreshMeta() {
      try {
        const response = await fetch("./meta?t=" + Date.now(), { cache: "no-store" });
        if (!response.ok) return;
        const meta = await response.json();
        if (meta.updatedAt && updatedAtNode) {
          updatedAtNode.textContent = meta.updatedAt;
        }
        if (meta.updatedAt && meta.updatedAt !== currentUpdatedAt) {
          currentUpdatedAt = meta.updatedAt;
          reloadFrame();
        }
      } catch {
      }
    }

    function step(timestamp) {
      if (!lastTick) {
        lastTick = timestamp;
      }

      const scrollable = getScrollable();
      const elapsed = (timestamp - lastTick) / 1000;
      lastTick = timestamp;

      if (running && scrollable && timestamp >= pauseUntil) {
        const speed = Number(speedInput.value);
        scrollable.scrollTop += direction * speed * elapsed;

        const maxScroll = scrollable.scrollHeight - scrollable.clientHeight;

        if (scrollable.scrollTop <= 0) {
          scrollable.scrollTop = 0;
          direction = 1;
          directionButton.textContent = "Down";
          pauseUntil = timestamp + Number(pauseInput.value);
        } else if (scrollable.scrollTop >= maxScroll) {
          scrollable.scrollTop = maxScroll;
          direction = -1;
          directionButton.textContent = "Up";
          pauseUntil = timestamp + Number(pauseInput.value);
        }
      }

      if (timestamp - lastMetaFetch > 5000) {
        lastMetaFetch = timestamp;
        refreshMeta();
      }

      requestAnimationFrame(step);
    }

    toggleButton.addEventListener("click", () => {
      running = !running;
      toggleButton.textContent = running ? "Pause" : "Resume";
    });

    directionButton.addEventListener("click", () => {
      direction *= -1;
      directionButton.textContent = direction === 1 ? "Down" : "Up";
    });

    function handleFrameLoad(event) {
      const loadedFrame = event.target;
      const isInitialActiveLoad = loadedFrame === activeFrame && !isReloading;
      const isStandbyReload = loadedFrame === standbyFrame && isReloading;

      if (!isInitialActiveLoad && !isStandbyReload) {
        return;
      }

      applyRestoredScroll(loadedFrame);

      if (isStandbyReload) {
        swapFrames();
      }
    }

    frameA.addEventListener("load", handleFrameLoad);
    frameB.addEventListener("load", handleFrameLoad);

    requestAnimationFrame(step);
  </script>
</body>
</html>
