<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ title }}</title>
  <style>
    :root {
      --bg: #0f1720;
      --panel: rgba(15, 23, 32, 0.82);
      --text: #e8eef2;
      --muted: #9db0bd;
      --accent: #f4b942;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: "Segoe UI", sans-serif;
      background:
        radial-gradient(circle at top, rgba(244,185,66,0.18), transparent 28%),
        linear-gradient(180deg, #15212c 0%, #0f1720 100%);
      color: var(--text);
    }

    .layout {
      min-height: 100vh;
      display: grid;
      grid-template-rows: auto 1fr;
    }

    .layout.toolbar-hidden {
      grid-template-rows: 1fr;
    }

    .toolbar {
      display: flex;
      gap: 12px;
      align-items: center;
      padding: 14px 18px;
      background: var(--panel);
      backdrop-filter: blur(16px);
      position: sticky;
      top: 0;
      z-index: 2;
      flex-wrap: wrap;
    }

    .layout.toolbar-hidden .toolbar {
      display: none;
    }

    .toolbar h1 {
      font-size: 16px;
      margin: 0 18px 0 0;
      letter-spacing: 0.02em;
    }

    .toolbar .meta {
      color: var(--muted);
      font-size: 13px;
      margin-right: auto;
    }

    .toolbar button,
    .toolbar input {
      font: inherit;
    }

    .toolbar button {
      border: 0;
      background: var(--accent);
      color: #1c1607;
      padding: 8px 14px;
      border-radius: 999px;
      cursor: pointer;
      font-weight: 600;
    }

    .toolbar label {
      display: flex;
      gap: 8px;
      align-items: center;
      color: var(--muted);
      font-size: 13px;
    }

    .toolbar-controls {
      flex: 1 0 100%;
      display: flex;
      gap: 12px;
      align-items: center;
      justify-content: flex-end;
      flex-wrap: wrap;
    }

    .frame-stack {
      position: relative;
      height: calc(100vh - 70px);
      background: white;
      overflow: hidden;
    }

    .layout.toolbar-hidden .frame-stack {
      height: 100vh;
    }

    iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
      background: white;
      opacity: 0;
      pointer-events: none;
      transition: opacity 120ms linear;
    }

    iframe.active {
      opacity: 1;
      pointer-events: auto;
    }

    .panel-toggle {
      position: fixed;
      right: 16px;
      bottom: 16px;
      z-index: 3;
      border: 0;
      background: var(--accent);
      color: #1c1607;
      padding: 10px 14px;
      border-radius: 999px;
      cursor: pointer;
      font: inherit;
      font-weight: 600;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.25);
    }

    .layout:fullscreen {
      background: #000;
    }

    .layout:fullscreen .frame-stack {
      height: calc(100vh - 70px);
    }

    .layout.toolbar-hidden:fullscreen .frame-stack {
      height: 100vh;
    }

    .debug-overlay {
      position: fixed;
      left: 16px;
      bottom: 16px;
      z-index: 4;
      width: min(420px, calc(100vw - 32px));
      max-height: min(45vh, 360px);
      overflow: auto;
      padding: 12px 14px;
      border-radius: 12px;
      background: rgba(8, 12, 18, 0.9);
      color: #dce6ec;
      font: 12px/1.45 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
      white-space: pre-wrap;
    }

    .debug-overlay[hidden] {
      display: none;
    }
  </style>
</head>
<body>
  <div class="layout" id="layout">
    <div class="toolbar">
      <h1>{{ title }}</h1>
      <div class="meta">
        source: <span id="sourceFileName">{{ sourceFileName }}</span>
        | report: <span id="reportType">{{ reportType }}</span>
        | updated: <span id="updatedAt">{{ updatedAt }}</span>
      </div>
      <button id="panelToggleInline">Hide Panel</button>
      <button id="fullscreenToggle">Fullscreen</button>
      <button id="toggle">Pause</button>
      <button id="direction">Down</button>
      <div class="toolbar-controls">
        <label><input id="activeToggle" type="checkbox" /> Show Active</label>
        <label><input id="openClassToggle" type="checkbox" checked /> Show ALL</label>
        <label><input id="clubToggle" type="checkbox" checked /> Show Club</label>
        <label>Speed <input id="speed" type="range" min="10" max="200" step="5" value="45" /></label>
        <label>Pause edge <input id="pause" type="range" min="0" max="5000" step="250" value="1500" /></label>
      </div>
    </div>
    <div class="frame-stack">
      <iframe id="reportFrameA" class="active" src="./report" title="{{ title }}"></iframe>
      <iframe id="reportFrameB" src="about:blank" title="{{ title }}"></iframe>
    </div>
  </div>
  <button id="panelToggleFloating" class="panel-toggle" type="button">Hide Panel</button>
  <div id="debugOverlay" class="debug-overlay" hidden></div>
  <script>
    const layout = document.getElementById("layout");
    const frameA = document.getElementById("reportFrameA");
    const frameB = document.getElementById("reportFrameB");
    const panelToggleInlineButton = document.getElementById("panelToggleInline");
    const panelToggleFloatingButton = document.getElementById("panelToggleFloating");
    const fullscreenToggleButton = document.getElementById("fullscreenToggle");
    const toggleButton = document.getElementById("toggle");
    const directionButton = document.getElementById("direction");
    const activeToggle = document.getElementById("activeToggle");
    const openClassToggle = document.getElementById("openClassToggle");
    const clubToggle = document.getElementById("clubToggle");
    const speedInput = document.getElementById("speed");
    const pauseInput = document.getElementById("pause");
    const updatedAtNode = document.getElementById("updatedAt");
    const sourceFileNameNode = document.getElementById("sourceFileName");
    const reportTypeNode = document.getElementById("reportType");
    const debugOverlay = document.getElementById("debugOverlay");
    const urlParams = new URLSearchParams(window.location.search);
    const debugScroll = urlParams.get("debugScroll") === "1";

    let running = true;
    let direction = 1;
    let lastTick = 0;
    let pauseUntil = 0;
    let lastMetaFetch = 0;
    let currentUpdatedAt = "{{ updatedAt }}";
    let pendingScrollTop = 0;
    let pendingScrollRatio = 0;
    let pendingDistanceFromBottom = 0;
    let pendingDirection = 1;
    let hasPendingScrollRestore = false;
    let virtualScrollTop = 0;
    let activeFrame = frameA;
    let standbyFrame = frameB;
    let isReloading = false;
    let toolbarHidden = false;
    let showActive = false;
    let showOpenClass = true;
    let showClub = true;
    let lastDebugLogAt = 0;
    let lastObservedScrollTop = 0;
    let lastObservedDirection = 1;
    let stalledFrameCount = 0;
    const debugEvents = [];

    function renderDebugOverlay(snapshot) {
      if (!debugScroll || !debugOverlay) {
        return;
      }

      debugOverlay.hidden = false;

      const lines = [
        "debugScroll=1",
        `running=${running} direction=${direction} pauseUntil=${Math.round(pauseUntil)}`,
        `scrollTop=${snapshot.scrollTop} virtualScrollTop=${snapshot.virtualScrollTop}`,
        `maxScroll=${snapshot.maxScroll} elapsed=${snapshot.elapsed} speed=${snapshot.speed}`,
        `activeFrame=${activeFrame.id} isReloading=${isReloading} stalledFrames=${stalledFrameCount}`,
        "",
        ...debugEvents.slice(-8),
      ];

      debugOverlay.textContent = lines.join("\n");
    }

    function debugLog(event, details = {}) {
      if (!debugScroll) {
        return;
      }

      const entry = `${new Date().toLocaleTimeString()} ${event} ${JSON.stringify(details)}`;
      debugEvents.push(entry);
      if (debugEvents.length > 20) {
        debugEvents.shift();
      }

      console.log("[viewer-scroll]", event, details);
    }

    function formatBrowserLocalDateTime(value) {
      const parsed = new Date(value);

      if (Number.isNaN(parsed.getTime())) {
        return value;
      }

      return new Intl.DateTimeFormat(undefined, {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
      }).format(parsed);
    }

    function getScrollable(targetFrame = activeFrame) {
      const doc = targetFrame.contentDocument;
      if (!doc) return null;
      return doc.scrollingElement || doc.documentElement;
    }

    function applyActiveVisibility(targetFrame = activeFrame) {
      const doc = targetFrame.contentDocument;
      if (!doc) {
        return;
      }

      const activeRows = doc.querySelectorAll("tr[data-status='Active']");

      for (const row of activeRows) {
        row.style.display = showActive ? "" : "none";
      }
    }

    function applyOpenClassVisibility(targetFrame = activeFrame) {
      const doc = targetFrame.contentDocument;
      if (!doc) {
        return;
      }

      const openClassBlocks = doc.querySelectorAll(".class-block[data-class-group='ALL']");

      for (const block of openClassBlocks) {
        block.style.display = showOpenClass ? "" : "none";
      }
    }

    function applyClubVisibility(targetFrame = activeFrame) {
      const doc = targetFrame.contentDocument;
      if (!doc) {
        return;
      }

      const tables = doc.querySelectorAll("table");

      for (const table of tables) {
        const headerRow = table.querySelector("thead tr");
        if (!headerRow) {
          continue;
        }

        const headerCells = [...headerRow.children];
        const clubColumnIndex = headerCells.findIndex((cell) => {
          const label = (cell.textContent || "").trim();
          return label === "Регіон" || label === "Організація";
        });

        if (clubColumnIndex === -1) {
          continue;
        }

        const rows = table.querySelectorAll("tr");

        for (const row of rows) {
          const cell = row.children[clubColumnIndex];
          if (cell && "style" in cell) {
            cell.style.display = showClub ? "" : "none";
          }
        }
      }
    }

    function reloadFrame() {
      if (isReloading) {
        return;
      }

      const scrollable = getScrollable();

      if (scrollable) {
        const maxScroll = Math.max(0, scrollable.scrollHeight - scrollable.clientHeight);
        pendingScrollTop = scrollable.scrollTop;
        pendingScrollRatio = maxScroll > 0 ? scrollable.scrollTop / maxScroll : 0;
        pendingDistanceFromBottom = Math.max(0, maxScroll - scrollable.scrollTop);
        pendingDirection = direction;
        hasPendingScrollRestore = true;
        debugLog("reload-frame", {
          scrollTop: scrollable.scrollTop,
          maxScroll,
          pendingScrollRatio,
          pendingDistanceFromBottom,
          pendingDirection,
        });
      }

      isReloading = true;
      standbyFrame.src = "./report?t=" + Date.now();
    }

    function applyRestoredScroll(targetFrame) {
      applyActiveVisibility(targetFrame);
      applyOpenClassVisibility(targetFrame);
      applyClubVisibility(targetFrame);

      const scrollable = getScrollable(targetFrame);

      if (!scrollable) {
        return;
      }

      if (hasPendingScrollRestore) {
        const maxScroll = Math.max(0, scrollable.scrollHeight - scrollable.clientHeight);
        const restoredScrollTop = maxScroll <= 0
          ? 0
          : pendingDirection === -1
            ? Math.min(maxScroll, Math.max(0, maxScroll - pendingDistanceFromBottom))
            : Math.min(maxScroll, Math.max(0, pendingScrollRatio * maxScroll));

        scrollable.scrollTop = restoredScrollTop || pendingScrollTop;
        virtualScrollTop = scrollable.scrollTop;
        direction = pendingDirection;
        pauseUntil = 0;
        directionButton.textContent = direction === 1 ? "Down" : "Up";
        hasPendingScrollRestore = false;
        debugLog("restore-scroll", {
          restoredScrollTop: scrollable.scrollTop,
          virtualScrollTop,
          maxScroll,
          direction,
        });
        return;
      }

      scrollable.scrollTop = 0;
      virtualScrollTop = 0;
      debugLog("initial-scroll", {
        scrollTop: 0,
        virtualScrollTop: 0,
      });
    }

    function swapFrames() {
      activeFrame.classList.remove("active");
      standbyFrame.classList.add("active");

      const previousActive = activeFrame;
      activeFrame = standbyFrame;
      standbyFrame = previousActive;
      isReloading = false;
    }

    function renderPanelToggle() {
      const label = toolbarHidden ? "Show Panel" : "Hide Panel";
      panelToggleInlineButton.textContent = label;
      panelToggleFloatingButton.textContent = label;
      layout.classList.toggle("toolbar-hidden", toolbarHidden);
    }

    function renderFullscreenToggle() {
      fullscreenToggleButton.textContent = document.fullscreenElement === layout
        ? "Exit Fullscreen"
        : "Fullscreen";
    }

    async function refreshMeta() {
      try {
        const response = await fetch("./meta?t=" + Date.now(), { cache: "no-store" });
        if (!response.ok) return;
        const meta = await response.json();
        if (meta.updatedAt && updatedAtNode) {
          updatedAtNode.textContent = formatBrowserLocalDateTime(meta.updatedAt);
        }
        if (meta.sourceFileName && sourceFileNameNode) {
          sourceFileNameNode.textContent = meta.sourceFileName;
        }
        if (meta.reportType && reportTypeNode) {
          reportTypeNode.textContent = meta.reportType;
        }
        if (meta.updatedAt && meta.updatedAt !== currentUpdatedAt) {
          currentUpdatedAt = meta.updatedAt;
          reloadFrame();
        }
      } catch {
      }
    }

    function step(timestamp) {
      if (!lastTick) {
        lastTick = timestamp;
      }

      const scrollable = getScrollable();
      const elapsed = (timestamp - lastTick) / 1000;
      lastTick = timestamp;
      const debugSnapshot = {
        scrollTop: scrollable ? Math.round(scrollable.scrollTop * 100) / 100 : null,
        virtualScrollTop: Math.round(virtualScrollTop * 100) / 100,
        maxScroll: scrollable
          ? Math.max(0, scrollable.scrollHeight - scrollable.clientHeight)
          : null,
        elapsed: Math.round(elapsed * 1000) / 1000,
        speed: Number(speedInput.value),
      };

      if (running && scrollable && timestamp >= pauseUntil) {
        const speed = Number(speedInput.value);
        const maxScroll = Math.max(0, scrollable.scrollHeight - scrollable.clientHeight);

        if (Math.abs(scrollable.scrollTop - virtualScrollTop) > 1) {
          debugLog("sync-virtual-scroll", {
            scrollTop: scrollable.scrollTop,
            virtualScrollTopBefore: virtualScrollTop,
            direction,
          });
          virtualScrollTop = scrollable.scrollTop;
        }

        virtualScrollTop += direction * speed * elapsed;

        if (virtualScrollTop <= 0) {
          virtualScrollTop = 0;
          scrollable.scrollTop = 0;
          direction = 1;
          directionButton.textContent = "Down";
          pauseUntil = timestamp + Number(pauseInput.value);
          stalledFrameCount = 0;
          debugLog("edge-top", {
            scrollTop: scrollable.scrollTop,
            virtualScrollTop,
            pauseUntil,
          });
        } else if (virtualScrollTop >= maxScroll) {
          virtualScrollTop = maxScroll;
          scrollable.scrollTop = maxScroll;
          direction = -1;
          directionButton.textContent = "Up";
          pauseUntil = timestamp + Number(pauseInput.value);
          stalledFrameCount = 0;
          debugLog("edge-bottom", {
            scrollTop: scrollable.scrollTop,
            virtualScrollTop,
            maxScroll,
            pauseUntil,
          });
        } else {
          scrollable.scrollTop = virtualScrollTop;

          if (
            Math.round(scrollable.scrollTop) === Math.round(lastObservedScrollTop) &&
            direction === lastObservedDirection
          ) {
            stalledFrameCount += 1;
          } else {
            stalledFrameCount = 0;
          }

          if (stalledFrameCount >= 20) {
            debugLog("stall-detected", {
              scrollTop: scrollable.scrollTop,
              virtualScrollTop,
              maxScroll,
              direction,
              elapsed,
              speed,
              stalledFrameCount,
            });
            stalledFrameCount = 0;
          }
        }

        lastObservedScrollTop = scrollable.scrollTop;
        lastObservedDirection = direction;

        if (debugScroll && timestamp - lastDebugLogAt > 1000) {
          lastDebugLogAt = timestamp;
          debugLog("tick", {
            scrollTop: scrollable.scrollTop,
            virtualScrollTop,
            maxScroll,
            direction,
            running,
            pauseUntil,
            speed,
          });
        }
      }

      renderDebugOverlay(debugSnapshot);

      if (timestamp - lastMetaFetch > 5000) {
        lastMetaFetch = timestamp;
        refreshMeta();
      }

      requestAnimationFrame(step);
    }

    toggleButton.addEventListener("click", () => {
      running = !running;
      toggleButton.textContent = running ? "Pause" : "Resume";
    });

    activeToggle.addEventListener("change", () => {
      showActive = activeToggle.checked;
      applyActiveVisibility(activeFrame);
      applyActiveVisibility(standbyFrame);
    });

    openClassToggle.addEventListener("change", () => {
      showOpenClass = openClassToggle.checked;
      applyOpenClassVisibility(activeFrame);
      applyOpenClassVisibility(standbyFrame);
    });

    clubToggle.addEventListener("change", () => {
      showClub = clubToggle.checked;
      applyClubVisibility(activeFrame);
      applyClubVisibility(standbyFrame);
    });

    function togglePanelVisibility() {
      toolbarHidden = !toolbarHidden;
      renderPanelToggle();
    }

    panelToggleInlineButton.addEventListener("click", togglePanelVisibility);
    panelToggleFloatingButton.addEventListener("click", togglePanelVisibility);

    fullscreenToggleButton.addEventListener("click", async () => {
      if (document.fullscreenElement === layout) {
        await document.exitFullscreen();
        return;
      }

      toolbarHidden = true;
      renderPanelToggle();
      await layout.requestFullscreen();
    });

    document.addEventListener("fullscreenchange", () => {
      if (!document.fullscreenElement) {
        toolbarHidden = false;
        renderPanelToggle();
      }

      renderFullscreenToggle();
    });

    directionButton.addEventListener("click", () => {
      direction *= -1;
      directionButton.textContent = direction === 1 ? "Down" : "Up";
    });

    function handleFrameLoad(event) {
      const loadedFrame = event.target;
      const isInitialActiveLoad = loadedFrame === activeFrame && !isReloading;
      const isStandbyReload = loadedFrame === standbyFrame && isReloading;

      if (!isInitialActiveLoad && !isStandbyReload) {
        return;
      }

      debugLog("frame-load", {
        target: loadedFrame.id,
        isInitialActiveLoad,
        isStandbyReload,
      });

      applyRestoredScroll(loadedFrame);

      if (isStandbyReload) {
        swapFrames();
      }
    }

    frameA.addEventListener("load", handleFrameLoad);
    frameB.addEventListener("load", handleFrameLoad);

    if (updatedAtNode) {
      updatedAtNode.textContent = formatBrowserLocalDateTime(updatedAtNode.textContent);
    }

    renderPanelToggle();
    renderFullscreenToggle();

    requestAnimationFrame(step);
  </script>
</body>
</html>
